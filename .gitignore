# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build output ---
dist/
dist-electron/
build/
out/
*.tsbuildinfo
*.timestamp-*.mjs
.cache/
.quasar/

# --- Logs ---
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- Test & coverage ---
coverage/
.nyc_output/
*.lcov

# --- IDE / editor ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Docker / data volumes ---
# Сырые данные Mongo (WiredTiger) — не трекаем: нельзя безопасно копировать
# на живой БД, всё равно бесполезно (это зеркало, не логический дамп).
.data/mongo/*
!.data/mongo/.gitkeep
# Загруженные файлы (бинарный контент) — не трекаем. Только метаданные в
# коллекции 'file' идут в репо (если понадобится). Содержимое — в bind-mount
# файловой системы (см. compose.yaml, можно вынести на отдельный диск).
.data/file_store/*
!.data/file_store/.gitkeep
# Бэкапы mgob в `.data/mongo-backups/` — НАМЕРЕННО трекаем (git LFS
# не настроен, поэтому пока просто коммитим .gz; при росте — переедем).
# .log рядом с архивами — служебный stdout/stderr mongodump, в репо не нужен.
# Если захочешь локально не коммитить — добавь сюда .data/mongo-backups/**/*.
.data/mongo-backups/**/*.log
# Telegram-нотификатор: chat_id и runtime-стейт (enabled). Локальный,
# машино-зависимый, в репо не нужен.
.data/telegram-state.json
data/
*.sqlite
*.sqlite3
dump/

# --- Local dev certs (per-instance, regenerated on each machine) ---
infra/caddy/caddy-ca.crt
infra/caddy/caddy-ca.key

# --- Playwright artifacts ---
test-results/
playwright-report/
playwright/.cache/

# --- Misc ---
*.local
.tmp/
temp/

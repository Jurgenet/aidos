# AID root .env (copy to .env to use locally — .env is gitignored)

NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
PORT=3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/aid
MONGO_DB_NAME=aid

# Graceful shutdown timeout in ms
SHUTDOWN_TIMEOUT_MS=10000

# mgob (агент бэкапов Mongo) — нужно для endpoints /api/backups
# В compose поднимается автоматически и доступен по http://mgob:8090
# Локально без compose: http://localhost:8090
MGOB_URL=http://localhost:8090
BACKUPS_DIR=.data/mongo-backups
BACKUP_PLAN_ID=aid

# Telegram-нотификатор (опционально). Если TELEGRAM_BOT_TOKEN пустой —
# фича выключена, остальные TELEGRAM_* игнорируются.
# Создай бота через @BotFather, положи токен, отправь /start ему в
# чате — chat_id определится автоматически (или задай TELEGRAM_CHAT_ID
# явно). Подробности и команды: docs/TELEGRAM.md.
# TELEGRAM_BOT_TOKEN=123:abc
# TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=true
# TELEGRAM_POLL_INTERVAL_MS=5000

# Файловое хранилище. В compose FILE_STORE_DIR=/files (bind-mount на
# /.data/file_store), в локальном dev — .data/file_store относительно cwd.
# Максимальный размер одного файла (байт), по умолчанию 50 MB.
FILE_STORE_DIR=.data/file_store
FILE_MAX_SIZE=52428800

# AID root .env (copy to .env to use locally — .env is gitignored)

NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
PORT=3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/aid
MONGO_DB_NAME=aid

# Graceful shutdown timeout in ms
SHUTDOWN_TIMEOUT_MS=10000

# mgob (агент бэкапов Mongo) — нужно для endpoints /api/backups
# В compose поднимается автоматически и доступен по http://mgob:8090
# Локально без compose: http://localhost:8090
MGOB_URL=http://localhost:8090
BACKUPS_DIR=.data/mongo-backups
BACKUP_PLAN_ID=aid
